# Dependencies
node_modules/
.pnp.*
.yarn/*

# Secrets — NIEMALS committen (ChurchDesk-Read-Tokens!)
.env
.env.*
!.env.example
*.secret
secrets.*

# Build output
dist/
build/
*.tsbuildinfo

# Expo
apps/app/.expo/
apps/app/web-build/
apps/app/dist/
*.orig.*

# Native Projekte (apps/app/ios, apps/app/android) sind VERSIONIERT — die
# Release-Workflows bauen daraus. Ignoriert wird nur Generiertes; die
# Einzelheiten stehen in apps/app/.gitignore.

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS / Editor
.DS_Store
.idea/
.vscode/
*.swp

# Laufzeit-Daten der API (lokale Entwicklung; im Container ein Volume)
apps/api/data/

# iOS signing (lokal, NIE committen)
apps/app/dist-cert.p12
apps/app/moinkark.mobileprovision
apps/app/credentials.json

# Design-Quellgrafiken (lokal, nicht committen)
design/

# Workspace: nur der Root-Lock ist maßgeblich
apps/app/package-lock.json

# Vom Build erzeugt (npm run sync:map-worker) — nicht einchecken, sonst veraltet
# die Kopie still, wenn MapLibre aktualisiert wird.
apps/app/public/maplibre-gl-worker.mjs
apps/app/public/maplibre-gl-shared.mjs

# Python-Bytecode des Play-Upload-Skripts (entsteht beim lokalen Probelauf)
__pycache__/
*.pyc

# --- Arbeitsnotizen und lokale Konfiguration (gehoeren nicht ins Repo) ---
.planning/
.claude/
CLAUDE.local.md
HANDOFF*.md
UEBERGABE*.md
*review-notes*.md
.playwright-mcp/

# --- Zugangsdaten und Schluessel ---
.env
.env.*
!.env.example
*.env
secrets*
*.p8
*.p12
*.mobileprovision
*.jks
release.keystore
*service-account*.json

